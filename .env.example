# .env 템플릿 (교육용 가상 계정 - 외부 배포 금지)
# 사용법: cp .env.example .env  후 필요하면 값을 수정한다.
# 기본값 그대로도 docker-compose.yml / 로그인 화면과 맞게 동작한다.

# DB 접속 계정 (docker-compose.yml의 POSTGRES_USER / POSTGRES_PASSWORD와 같아야 한다)
DB_USERNAME=
DB_PASSWORD=

# 교육용 로그인 계정 (로그인 화면 안내 문구와 같아야 한다)
DEMO_LOGIN_USERNAME=
DEMO_LOGIN_PASSWORD=
